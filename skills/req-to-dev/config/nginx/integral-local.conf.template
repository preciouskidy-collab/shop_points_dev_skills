# 本机联调网关（方案 B）— 已迁移至 local-gateway.conf.template
# 本文件保留仅供对照，local_stack_up.py 不再渲染此模板。

worker_processes 1;
error_log {{NGINX_PREFIX}}/logs/error.log warn;
pid {{NGINX_PREFIX}}/nginx.pid;

events {
    worker_connections 1024;
}

http {
    access_log {{NGINX_PREFIX}}/logs/access.log;
    proxy_temp_path {{NGINX_PREFIX}}/proxy_temp;
    client_body_temp_path {{NGINX_PREFIX}}/client_body_temp;

    upstream frontend_dev {
        server 127.0.0.1:{{FRONTEND_PORT}};
    }

    upstream lottery_local {
        server 127.0.0.1:{{LOTTERY_PORT}};
    }

    server {
        listen {{NGINX_PORT}};
        server_name {{H5_HOST}};

        client_max_body_size 50m;

        # 商城 / 订单预览 API → 本地 shop-points-lottery（strip /activity-proxy）
        location /activity-proxy/ {
            proxy_pass http://lottery_local/;
            proxy_http_version 1.1;
            proxy_set_header Host {{LOTTERY_HOST_HEADER}};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # 浏览器跨域 POST 会带 Origin；本地 lottery CORS 白名单不含 integral:8088，需剥掉以免 403
            proxy_set_header Origin "";
            proxy_connect_timeout 60s;
            proxy_read_timeout 300s;
        }

        # 门店积分 API → 默认仍走 test01（本地未起 shop-points 时）
        location /integral-proxy/ {
            proxy_pass {{INTEGRAL_PROXY_TARGET}}/;
            proxy_http_version 1.1;
            proxy_set_header Host {{INTEGRAL_PROXY_HOST}};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_server_name on;
        }

        location /loginUser/ {
            proxy_pass {{INTEGRAL_PROXY_TARGET}}/loginUser/;
            proxy_http_version 1.1;
            proxy_set_header Host {{INTEGRAL_PROXY_HOST}};
        }

        # 前端 dev server + webpack HMR（bundle 约 7MB，需关闭缓冲避免截断）
        location / {
            proxy_pass http://frontend_dev;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 86400;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_max_temp_file_size 0;
        }
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
}
